# sanka-sdk SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: SANKA_
#
# Security environment variables:
SANKA_BEARER_AUTH=your_bearerauth_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
SANKA_DEBUG=true
